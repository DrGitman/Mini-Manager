# ── Backend (Python / FastAPI) ─────────────────────────────────────────────────
# Secrets — NEVER commit
backend/api/.env
backend/api/.env.local

# Virtual environment (hundreds of MB)
backend/api/.venv/
backend/api/venv/

# Python cache
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd

# Build / tooling artefacts
backend/**/*.egg-info/
backend/api/dist/
backend/api/build/
backend/api/.mypy_cache/
backend/api/.pytest_cache/
backend/api/htmlcov/
backend/api/.coverage

# Desktop installers — distributed from the website, never committed.
# These are 200MB+ and would bloat the repo permanently.
dist-electron/
*.exe
*.msi
*.blockmap

# Scratch space for kernel tests — outside AppData, which the kernel refuses.
.pytest-workspace/
.pytest_cache/
