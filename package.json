{
  "name": "mini-manager",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "backend": "backend\\api\\.venv\\Scripts\\python.exe -m uvicorn backend.api.main:app --reload --port 8000",
    "dev:all": "concurrently --kill-others --names \"web,api\" -c \"cyan,magenta\" \"next dev\" \"pnpm backend\"",
    "electron:dev": "concurrently --kill-others \"next dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron electron/main.js\"",
    "electron:build": "next build && node scripts/prepare-standalone.mjs && electron-builder",
    "electron:pack": "next build && node scripts/prepare-standalone.mjs && electron-builder --dir"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.55",
    "@base-ui/react": "^1.5.0",
    "@paddle/paddle-js": "^1.6.4",
    "@vercel/analytics": "1.6.1",
    "ai": "^7.0.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "wait-on": "^8.0.5"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  }
}
