# ─── Database ────────────────────────────────────────────────────────────────
# Neon connection string (postgres://user:pass@host/db?sslmode=require)
DATABASE_URL=postgres://your_user:your_password@your-neon-host.neon.tech/your_db?sslmode=require

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_64_char_random_hex_string

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Production frontend URL (no trailing slash)
FRONTEND_URL=https://mini-manager.vercel.app

# ─── General ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PORT=8000
