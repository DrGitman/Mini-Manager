# Backend settings for Mini Manager.
# Copy this file to backend/api/.env and fill in your own values.
# Never commit the real .env file.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (a free Neon database works)
DATABASE_URL=postgres://your_user:your_password@your_host/your_db?sslmode=require

# A long random string used to sign login tokens.
# Make one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_64_character_random_string

# Google Gemini key: the agent's reasoning
GEMINI_API_KEY=your_gemini_key

# Groq key: bulk file classification
GROQ_API_KEY=your_groq_key

# The address of the website, so the API accepts requests from it (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ── Optional ──────────────────────────────────────────────────────────────────

# Model names. Leave these out to use the defaults.
# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=openai/gpt-oss-120b

# Where a paused agent waits for your answer: "file" for local use, "s3" when hosted.
SESSION_BACKEND=file
# SESSION_S3_BUCKET=your_bucket
# SESSION_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret

# Email for run summaries and alerts. Leave SMTP_HOST empty to turn email off.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=Mini Manager <agent@example.com>

# Google sign in
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Other
# API_BASE_URL=http://localhost:8000
# EXTRA_CORS_ORIGINS=
ENVIRONMENT=development
