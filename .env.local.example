# Website settings for Mini Manager.
# Copy this file to .env.local and fill in your own values.

# Required: the address of the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: the public website address, used for links back to the site
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: the email address shown on contact and support links
# NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com

# Optional: set to 0 to switch back to the older assistant
# NEXT_PUBLIC_AGENT_V2=1
